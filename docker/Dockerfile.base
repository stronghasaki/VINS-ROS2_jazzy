# vins-jazzy-base：依赖层（源码层见 Dockerfile.dev，依赖不变时无需重建）
FROM ros:jazzy

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# 容器内换阿里云源（noble），加速 apt
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list 2>/dev/null; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; true

RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential \
        libgoogle-glog-dev libgflags-dev libatlas-base-dev libsuitesparse-dev \
        libeigen3-dev libboost-filesystem-dev libboost-program-options-dev \
        libboost-system-dev libopencv-dev \
        python3-colcon-common-extensions python3-pip \
        ros-${ROS_DISTRO}-image-transport \
        ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-visualization-msgs \
        ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-message-filters \
    && rm -rf /var/lib/apt/lists/*

# Ceres 2.1.0（上游钦定版本，勿升级：2.2 移除 LocalParameterization）
# 用本地 tarball 而非 git clone：镜像构建不依赖外网，且可复现
COPY ceres-2.1.0.tar.gz /tmp/
RUN cd /tmp && tar xzf ceres-2.1.0.tar.gz && \
    cd ceres-solver-2.1.0 && mkdir build && cd build && \
    cmake .. -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DCXSPARSE=OFF && \
    make -j$(nproc) && make install && \
    rm -rf /tmp/ceres-solver-2.1.0 /tmp/ceres-2.1.0.tar.gz

# evo 在开发容器内按需安装（jammy 主机无 PEP668，也可装在宿主机）
WORKDIR /ws
CMD ["/bin/bash"]
